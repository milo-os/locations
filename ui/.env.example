# Kubernetes API server connection (used server-side by Remix loaders)
# Option 1: Explicit credentials
LOCATIONS_API_SERVER_URL=https://your-api-server:6443
LOCATIONS_API_CA_FILE=/path/to/ca.crt
LOCATIONS_API_TOKEN_FILE=/path/to/token

# Option 1b: Client certificate auth (used when token file is not set)
LOCATIONS_API_CERT_FILE=/path/to/client.crt
LOCATIONS_API_KEY_FILE=/path/to/client.key

# Option 2: Use local kubeconfig (development)
# Defaults to .test-infra/kubeconfig if not set
# (no env var needed — falls back automatically when LOCATIONS_API_SERVER_URL is unset)

# Note: rename these to match your service after running hack/rename.sh
